[Unit]
Description=data-collector archive (1s bars)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/data-collector
Environment=RUST_LOG=info
ExecStart=/opt/data-collector/archive --config /opt/data-collector/config/collector.yaml
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
